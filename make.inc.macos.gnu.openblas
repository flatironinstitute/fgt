# makefile overrides
# OS:       macOS (Intel or Apple Silicon)
# Compiler: Homebrew gfortran (>= 13)
# OpenMP:   enabled
# BLAS:     OpenBLAS (Homebrew, `brew install openblas`)
# FFTW:     Homebrew (`brew install fftw`)
#
# NOTE for user:
#   * Same compiler auto-detection as make.inc.macos.gnu.
#   * Use this if you want OpenBLAS instead of Apple Accelerate
#     (e.g. for reproducibility across architectures).
#   * WARNING: Homebrew's libopenblas links against Apple's libomp,
#     which conflicts with libgomp from Homebrew gcc inside the same
#     process. The bfgt validation test in particular returns garbage
#     with this combination. Prefer make.inc.macos.gnu (Accelerate)
#     unless you are willing to rebuild OpenBLAS with USE_OPENMP=0
#     or work around the runtime conflict yourself.

# grep filters out gcc-ar-N etc. (see make.inc.macos.gnu).
HOMEBREW_PREFIX := $(shell brew --prefix 2>/dev/null)
GFORTRAN_BIN := $(shell ls $(HOMEBREW_PREFIX)/bin/gfortran-* 2>/dev/null | grep -E '/gfortran-[0-9]+$$' | sort -V | tail -1)
GCC_BIN      := $(shell ls $(HOMEBREW_PREFIX)/bin/gcc-* 2>/dev/null | grep -E '/gcc-[0-9]+$$' | sort -V | tail -1)
GXX_BIN      := $(shell ls $(HOMEBREW_PREFIX)/bin/g++-* 2>/dev/null | grep -E '/g\+\+-[0-9]+$$' | sort -V | tail -1)

ifeq ($(GFORTRAN_BIN),)
$(error Could not find a Homebrew gfortran. Install one: `brew install gcc`. \
        Or set FC/CC/CXX explicitly on the make command line.)
endif

FC  = $(GFORTRAN_BIN)
CC  = $(GCC_BIN)
CXX = $(GXX_BIN)

FFLAGS= -fPIC -O3 -march=native -funroll-loops -std=legacy

ifeq ($(PREFIX),)
    FGT_INSTALL_DIR=$(HOME)/lib
endif

# FFTW from Homebrew.
ifeq ($(PREFIX_FFT),)
    FFTW_ROOT := $(shell brew --prefix fftw)
    FFT_INSTALL_DIR=$(FFTW_ROOT)/lib
endif

ifeq ($(PREFIX_FFT_INCLUDE),)
    FFTW_ROOT := $(shell brew --prefix fftw)
    FFT_INCLUDE_DIR=$(FFTW_ROOT)/include
endif

OMPFLAGS = -fopenmp
OMPLIBS  = -lgomp

# OpenBLAS from Homebrew. -L is needed because OpenBLAS is keg-only.
OPENBLAS_ROOT := $(shell brew --prefix openblas 2>/dev/null)
LBLAS = -L$(OPENBLAS_ROOT)/lib -lopenblas
LDBLASINC = -I$(OPENBLAS_ROOT)/include
