# makefile overrides
# OS:       Windows (MSYS2 / mingw-w64)
# Compiler: mingw-w64 gcc/gfortran
# OpenMP:   enabled (libgomp)
# BLAS:     OpenBLAS (mingw-w64-x86_64-openblas)
# FFTW:     mingw-w64 (mingw-w64-x86_64-fftw)
#
# NOTE for user:
#   * Run from an MSYS2 mingw64 shell with:
#       pacman -S mingw-w64-x86_64-{gcc,gcc-fortran,fftw,openblas,pkgconf}
#   * Compilers are taken from PATH; no version suffix needed in MSYS2.
#   * Output is libfgt.dll instead of libfgt.so.

FFLAGS = -fPIC -O3 -funroll-loops -std=legacy

# Override default linkage: emit .dll on Windows.
MINGW = ON

OMPFLAGS = -fopenmp
OMPLIBS  = -lgomp

LBLAS = -lopenblas
