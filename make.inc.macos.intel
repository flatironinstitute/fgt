# makefile overrides
# OS:       macOS (legacy Intel; Intel oneAPI no longer ships for Apple Silicon)
# Compiler: Intel oneAPI (icx/ifx)
# OpenMP:   enabled
# BLAS:     Intel MKL
#
# NOTE: Apple Silicon Macs cannot run Intel compilers natively. This
# make.inc is only useful on Intel Macs. Source setvars.sh first.

CC = icx
CXX = icpx
FC = ifx
FFLAGS= -fPIC -O3 -march=native -funroll-loops

OMPFLAGS = -qopenmp
OMPLIBS  =

LBLAS = -qmkl
